{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:provider": "node scripts/set-db-provider.mjs",
    "db:generate": "npm run db:provider && prisma generate",
    "db:push": "npm run db:provider && prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "e2e:db": "npm run db:provider && prisma db push --skip-generate && tsx prisma/seed.ts",
    "e2e": "playwright test",
    "postinstall": "prisma generate",
    "vercel-build": "node scripts/vercel-build.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "16.4.4",
    "next-auth": "^4.24.15",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.179.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.179.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.9"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
