# Copier ce fichier en .env (ignoré par git) et adapter les valeurs.
# Aucune donnée nominative ni secret réel ne doit figurer ici.

# --- Base de données ---------------------------------------------------------
# Développement : SQLite (fichier relatif au schéma, soit prisma/dev.db).
# Production : PostgreSQL, ex. postgresql://utilisateur:motdepasse@hote:5432/prestigeplaces
DATABASE_URL="file:./dev.db"
# sqlite (défaut) ou postgresql : lu par `npm run db:provider` (appelé par db:generate et db:push)
DB_PROVIDER="sqlite"

# --- Authentification (next-auth 4) -------------------------------------------
# false (défaut) : application ouverte, sans connexion, droits complets pour tous.
# true : connexion exigée (Entra ID, accès de démonstration ou mode développement ci-dessous).
AUTH_REQUIRED="false"
# URL publique de l'application : doit correspondre au port réellement servi.
NEXTAUTH_URL="http://localhost:3000"
# Clé de signature des sessions (JWT). Obligatoire hors mode développement.
# Générer par exemple avec : openssl rand -base64 32. AUTH_SECRET est accepté comme alias.
NEXTAUTH_SECRET="changer-moi-en-production"
# Fournisseur SSO Microsoft Entra ID : actif seulement si les trois valeurs sont renseignées.
# URL de redirection à déclarer dans Entra ID : <NEXTAUTH_URL>/api/auth/callback/azure-ad
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""
# Connexion de développement sans mot de passe (sélecteur de rôle) : true uniquement en local et pour les tests e2e.
# Garde-fou : ignoré en production si NEXTAUTH_URL ne pointe pas sur localhost. AUTH_DEV_LOGIN est un ancien alias.
AUTH_DEV_MODE="true"
# Rôle donné à un compte SSO absent de la table UserRole : LECTURE (défaut), MANAGER, DIRECTEUR,
# SERVICES_GENERAUX, ou AUCUN pour refuser la connexion.
AUTH_DEFAULT_ROLE="LECTURE"

# --- Import RH ---------------------------------------------------------------
# false (défaut) : seuls des effectifs agrégés sont conservés.
# true : conserve aussi les matricules hachés (SHA-256 salé) dans la table Person.
STORE_PERSONS="false"
# Sel de hachage des matricules, obligatoire si STORE_PERSONS=true (secret, à ne jamais versionner).
PERSON_HASH_SALT=""

# --- Tests de bout en bout (Playwright, facultatif) --------------------------
# `npm run e2e` utilise sa propre base (prisma/e2e.db) et son propre port ; ces variables sont lues
# par playwright.config.ts et ne concernent pas le serveur applicatif.
# E2E_PORT="3210"
# Chemin explicite de Chromium si la révision attendue par Playwright n'est pas installée
# (ne jamais lancer « playwright install » dans l'environnement d'intégration).
# PW_CHROMIUM_PATH=""
