# Base de données. Développement : SQLite. Production : PostgreSQL.
DATABASE_URL="file:./dev.db"
# sqlite (défaut) ou postgresql : lu par `npm run db:provider` avant `prisma generate`
DB_PROVIDER="sqlite"

# Authentification (next-auth 4)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="changer-moi-en-production"
# Fournisseur SSO (Entra ID) : à renseigner en production
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""
# Connexion de développement par e-mail sans mot de passe (true uniquement en local)
AUTH_DEV_MODE="true"
# Rôle donné à un compte SSO absent de UserRole (AUCUN refuse la connexion)
AUTH_DEFAULT_ROLE="LECTURE"


# Import RH : conserver les matricules hachés (SHA-256 salé) dans la table Person
STORE_PERSONS="false"
# Sel obligatoire si STORE_PERSONS=true
PERSON_HASH_SALT=""
